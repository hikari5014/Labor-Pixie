{
  "id": "notice-period",
  "title": "預告期間與預告工資",
  "rule": "notice-period",
  "source": "勞動基準法第 16 條",
  "cases": [
    {
      "name": "未滿 3 個月：不用預告",
      "input": {
        "hireDate": "2026-08-01",
        "endDate": "2026-10-15",
        "monthlyWage": 30000
      },
      "expected": {
        "months": 2,
        "days": 0,
        "latestNoticeDate": null,
        "noticePay": 0
      }
    },
    {
      "name": "剛好滿 3 個月：預告 10 日",
      "input": {
        "hireDate": "2026-07-16",
        "endDate": "2026-10-15",
        "monthlyWage": 30000
      },
      "expected": {
        "months": 3,
        "days": 10,
        "latestNoticeDate": "2026-10-05",
        "noticePay": 10000
      }
    },
    {
      "name": "差一天滿 3 個月",
      "input": {
        "hireDate": "2026-07-17",
        "endDate": "2026-10-15"
      },
      "expected": {
        "months": 2,
        "days": 0,
        "latestNoticeDate": null
      }
    },
    {
      "name": "滿 3 個月未滿 1 年：10 日",
      "input": {
        "hireDate": "2026-01-01",
        "endDate": "2026-10-15",
        "monthlyWage": 36000
      },
      "expected": {
        "months": 9,
        "days": 10,
        "latestNoticeDate": "2026-10-05",
        "noticePay": 12000
      }
    },
    {
      "name": "剛好滿 1 年：20 日",
      "input": {
        "hireDate": "2025-10-16",
        "endDate": "2026-10-15",
        "monthlyWage": 36000
      },
      "expected": {
        "months": 12,
        "days": 20,
        "latestNoticeDate": "2026-09-25",
        "noticePay": 24000
      }
    },
    {
      "name": "1 年以上未滿 3 年：20 日",
      "input": {
        "hireDate": "2024-03-01",
        "endDate": "2026-10-15",
        "monthlyWage": 40000
      },
      "expected": {
        "months": 31,
        "days": 20,
        "latestNoticeDate": "2026-09-25",
        "noticePay": 26667
      }
    },
    {
      "name": "剛好滿 3 年：30 日",
      "input": {
        "hireDate": "2023-10-16",
        "endDate": "2026-10-15",
        "monthlyWage": 45000
      },
      "expected": {
        "months": 36,
        "days": 30,
        "latestNoticeDate": "2026-09-15",
        "noticePay": 45000
      }
    },
    {
      "name": "3 年以上：30 日",
      "input": {
        "hireDate": "2010-01-01",
        "endDate": "2026-10-15",
        "monthlyWage": 50000
      },
      "expected": {
        "months": 201,
        "days": 30,
        "latestNoticeDate": "2026-09-15",
        "noticePay": 50000
      }
    },
    {
      "name": "試用期滿 3 個月後才通知：月薪 30,000 要付約 10,000",
      "input": {
        "hireDate": "2026-06-01",
        "endDate": "2026-09-30",
        "monthlyWage": 30000
      },
      "expected": {
        "months": 4,
        "days": 10,
        "latestNoticeDate": "2026-09-20",
        "noticePay": 10000
      }
    },
    {
      "name": "預告工資無條件進位",
      "input": {
        "hireDate": "2024-03-01",
        "endDate": "2026-10-15",
        "monthlyWage": 31000
      },
      "expected": {
        "months": 31,
        "days": 20,
        "latestNoticeDate": "2026-09-25",
        "noticePay": 20667
      }
    }
  ]
}
