{
  "id": "contract-terms",
  "title": "勞動契約條款檢查",
  "note": "拿一份勞動契約逐項對照：有沒有寫、寫得清不清楚。重大且要雙方同意的條件放契約；每天怎麼做的細節放工作規則或管理辦法。",
  "states": [
    {
      "id": "missing",
      "name": "沒寫"
    },
    {
      "id": "unclear",
      "name": "有寫但不清楚"
    },
    {
      "id": "ok",
      "name": "有寫而且清楚"
    }
  ],
  "groups": [
    {
      "id": "core",
      "title": "基本內容（法定應約定事項）",
      "items": [
        {
          "id": "place",
          "title": "工作地點，以及可能調派的範圍",
          "why": "寫太窄，遷廠或調派時容易爭議；寫「公司登記地、分公司或因業務需要指派之地點」較有彈性，但實際調動仍要合理。",
          "basis": [
            "N0030002",
            "7",
            "施行細則第 7 條"
          ]
        },
        {
          "id": "duty",
          "title": "到職職務，以及在合理範圍內可調派或轉換職能",
          "why": "只寫單一職務時，改派其他職務要重新取得同意。",
          "basis": [
            "N0030001",
            "10-1",
            "勞基法第 10-1 條"
          ]
        },
        {
          "id": "hours",
          "title": "上下班時間、休息時間、例假與休息日、輪班方式",
          "why": "休息時間沒寫，可能被算成工時。",
          "basis": [
            "N0030002",
            "7",
            "施行細則第 7 條"
          ]
        },
        {
          "id": "wage",
          "title": "工資結構：底薪、津貼、獎金，計算與發薪日",
          "why": "以保證給付的項目為主；額外獎金另訂辦法。包含加班費時要寫明種類與時數。",
          "basis": [
            "N0030002",
            "7",
            "施行細則第 7 條"
          ]
        },
        {
          "id": "term",
          "title": "定期或不定期；定期要寫明是哪一種工作與理由",
          "why": "繼續性工作應為不定期契約。",
          "basis": [
            "N0030001",
            "9",
            "勞基法第 9 條"
          ]
        },
        {
          "id": "ending",
          "title": "契約終止、資遣、退休的規定",
          "why": "依法定事由與程序，不能約定比法律更差的條件。",
          "basis": [
            "N0030002",
            "7",
            "施行細則第 7 條"
          ]
        }
      ]
    },
    {
      "id": "key",
      "title": "重要條款",
      "items": [
        {
          "id": "probation",
          "title": "試用期：期間、考核標準、不適任的處理",
          "why": "除了終止權以外一切照勞基法；要有實際考核紀錄。",
          "basis": [
            "N0030001",
            "11",
            "勞基法第 11 條"
          ]
        },
        {
          "id": "holiday-swap",
          "title": "國定假日調移、加班補休的方式",
          "why": "國定假日調移要勞工同意；加班換補休依勞工意願。",
          "basis": [
            "N0030001",
            "32-1",
            "勞基法第 32-1 條"
          ]
        },
        {
          "id": "injury",
          "title": "職災時的工作安置、就醫與工資",
          "why": "醫療期間按原領工資補償，且原則上不得終止契約。",
          "basis": [
            "N0030001",
            "59",
            "勞基法第 59 條"
          ]
        },
        {
          "id": "side-job",
          "title": "在職期間兼職的限制與申請",
          "why": "限制要合理，和職務、營業秘密有關。",
          "basis": [
            "N0030001",
            "9-1",
            "勞基法第 9-1 條"
          ]
        },
        {
          "id": "non-compete",
          "title": "離職後競業禁止：期間、範圍、補償",
          "why": "要符合四個條件並以書面約定，最長 2 年，要有合理補償，否則無效。",
          "basis": [
            "N0030002",
            "7-1",
            "施行細則第 7-1 條"
          ]
        },
        {
          "id": "short-notice",
          "title": "離職未依規定預告的責任",
          "why": "不能直接從工資扣，要另外請求賠償（工資應全額直接給付）。",
          "basis": [
            "N0030001",
            "22",
            "勞基法第 22 條"
          ]
        },
        {
          "id": "secrets",
          "title": "營業秘密的範圍、保密義務與措施",
          "why": "要有合理的保密措施，約定才有意義。",
          "basis": [
            "N0030001",
            "12",
            "勞基法第 12 條第 5 款"
          ]
        },
        {
          "id": "misconduct",
          "title": "禁止職場不法侵害、惡意申訴與報復，以及懲戒方式",
          "why": "配合 115/7/1 職場霸凌防治新制。",
          "basis": [
            "N0060001",
            "22-1",
            "職安法第 22-1 條"
          ]
        }
      ]
    }
  ],
  "checked_on": "2026-10-16"
}
