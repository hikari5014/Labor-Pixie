{
  "id": "company-audit",
  "title": "公司體檢清單",
  "note": "每一項依「沒有／有但內容不對／對但沒落實／有做但沒紀錄／完整」自評。目標是正確＋落實＋有紀錄。",
  "states": [
    {
      "id": "missing",
      "name": "沒有"
    },
    {
      "id": "wrong",
      "name": "有，但內容不對"
    },
    {
      "id": "not-done",
      "name": "內容對，但沒落實"
    },
    {
      "id": "no-record",
      "name": "有做，但沒留紀錄"
    },
    {
      "id": "ok",
      "name": "完整"
    }
  ],
  "groups": [
    {
      "id": "documents",
      "title": "文件與制度",
      "items": [
        {
          "id": "contract",
          "title": "每位員工都有書面勞動契約，寫明工作地點、職務、工時與休息、休假、薪資結構",
          "why": "沒有書面約定時，爭議發生幾乎無法反駁勞工的主張。",
          "basis": [
            [
              "N0030002",
              "7",
              "施行細則第 7 條"
            ]
          ]
        },
        {
          "id": "work-rules",
          "title": "訂有工作規則，報主管機關核備並公開揭示",
          "why": "30 人以上是法定義務；未滿 30 人也建議訂。",
          "basis": [
            [
              "N0030001",
              "70",
              "勞動基準法第 70 條"
            ]
          ],
          "min_employees": 30
        },
        {
          "id": "break-times",
          "title": "工作規則或契約寫明每日上下班與休息時間",
          "why": "沒寫休息時間，休息可能被算成工時。",
          "basis": [
            [
              "N0030001",
              "35",
              "勞動基準法第 35 條"
            ]
          ]
        },
        {
          "id": "overtime-policy",
          "title": "加班管理辦法：事前申請、主管核准、計算方式，並公開周知",
          "why": "出勤紀錄上的時間會被推定為經同意的工時，只說「沒申請」不夠。",
          "basis": [
            [
              "B0010064",
              "38",
              "勞動事件法第 38 條"
            ]
          ]
        },
        {
          "id": "travel-policy",
          "title": "出差管理辦法：是否先到公司、交通時間怎麼算、津貼、返程補休",
          "why": "沒有辦法時，出差的交通時間很容易被主張為加班。",
          "basis": [
            [
              "N0030002",
              "18",
              "施行細則第 18 條"
            ]
          ]
        },
        {
          "id": "bonus-policy",
          "title": "獎金辦法寫明性質與發放條件，並保留依營運狀況調整的權利",
          "why": "個人達標就確定拿到的獎金，容易被認定為工資。",
          "basis": [
            [
              "N0030001",
              "2",
              "勞動基準法第 2 條第 3 款"
            ],
            [
              "N0030001",
              "29",
              "第 29 條"
            ]
          ]
        },
        {
          "id": "bullying",
          "title": "職場霸凌：10 人以上訂申訴管道並公開揭示；30 人以上訂防治措施、申訴及懲處規範",
          "why": "115/7/1 起施行；雇主知悉後要立即採取有效措施。",
          "basis": [
            [
              "N0060001",
              "22-1",
              "職業安全衛生法第 22-1 條"
            ]
          ],
          "min_employees": 10
        },
        {
          "id": "harassment",
          "title": "性騷擾：10 人以上訂申訴管道；30 人以上訂防治措施、申訴及懲戒規範，並公開揭示",
          "why": "違反可處罰鍰，且影響事件處理的正當性。",
          "basis": [
            [
              "N0030014",
              "13",
              "性別平等工作法第 13 條"
            ]
          ],
          "min_employees": 10
        },
        {
          "id": "transfer-clause",
          "title": "契約保留合理的調動範圍，實際調動符合調動五原則",
          "why": "契約沒寫或調動不合理，勞工可拒絕並主張資遣費。",
          "basis": [
            [
              "N0030001",
              "10-1",
              "勞動基準法第 10-1 條"
            ]
          ]
        }
      ]
    },
    {
      "id": "records",
      "title": "紀錄與表單",
      "items": [
